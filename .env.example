# Copy to your deployment secret manager / local .env (never commit real values).
# App security (generate a long random secret; rotate it)
LANDGUARD_APP_SECRET=

# Government connectors: remain disabled until written authorization, approved API docs,
# sandbox and production credentials are received from each provider.
TS_BHU_BHARATI_ENABLED=false
TS_BHU_BHARATI_BASE_URL=
TS_BHU_BHARATI_CLIENT_ID=
TS_BHU_BHARATI_CLIENT_SECRET=
TS_BHU_BHARATI_API_KEY=

AP_MEEBHOOMI_WEBLAND_ENABLED=false
AP_MEEBHOOMI_WEBLAND_BASE_URL=
AP_MEEBHOOMI_WEBLAND_CLIENT_ID=
AP_MEEBHOOMI_WEBLAND_CLIENT_SECRET=
AP_MEEBHOOMI_WEBLAND_API_KEY=

# Notifications: credentials alone are not enough; provider adapters and consent checks
# must be implemented and delivery tested before enabling.
LANDGUARD_EMAIL_PROVIDER=
LANDGUARD_EMAIL_API_KEY=
LANDGUARD_EMAIL_FROM=
LANDGUARD_SMS_PROVIDER=
LANDGUARD_SMS_API_KEY=
LANDGUARD_SMS_SENDER_ID=
LANDGUARD_WHATSAPP_PROVIDER=
LANDGUARD_WHATSAPP_API_KEY=
LANDGUARD_WHATSAPP_SENDER_ID=

# Future production infrastructure (not yet consumed by the existing Streamlit MVP)
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
SENTRY_DSN=
